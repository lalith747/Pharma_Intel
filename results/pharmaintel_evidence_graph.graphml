      <data key="d3">24690066</data>
      <data key="d6">3</data>
      <data key="d7">METHODS: We present the case of a young woman treated with clozapine at a first-episode psychosis clinic after a moderate quetiapine XR-induced neutropenia (0,5-1,0 × 10(9) L(-1) ).</data>
      <data key="d8">supported</data>
      <data key="d9">[{"type": "causal_wording", "text": "induced", "start": 136, "end": 143}]</data>
      <data key="d10">[]</data>
