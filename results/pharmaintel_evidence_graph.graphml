      <data key="d2">co_mention evidence</data>
      <data key="d3">40302427</data>
      <data key="d6">9</data>
      <data key="d7">No patients discontinued clozapine because of severe neutropenia, and only one patient had severe neutropenia during the study period.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[{"kind": "negation", "text": "No ", "start": 0, "end": 3}]</data>
