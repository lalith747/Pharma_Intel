      <data key="d2">supported evidence</data>
      <data key="d3">24975932</data>
      <data key="d6">4</data>
      <data key="d7">Clozapine, which has the strongest antipsychotic effect, can cause neutropenia.</data>
      <data key="d8">supported</data>
      <data key="d9">[{"type": "causal_wording", "text": "cause", "start": 61, "end": 66}]</data>
      <data key="d10">[]</data>
