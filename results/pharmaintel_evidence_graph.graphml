    <node id="publication:15235527">
      <data key="d1">publication</data>
      <data key="d2">PMID 15235527</data>
      <data key="d3">15235527</data>
      <data key="d4">[Ten years of clinical experience with clozapine about 170 patients].</data>
      <data key="d5">2004</data>
    </node>
    <node id="evidence:15235527:17:00901">
      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">15235527</data>
      <data key="d6">17</data>
      <data key="d7">Treatment was stopped for side effects in 17.1% of patients; for ineffectiveness in 14.7% and 3% of patients died during treatment (their death attributed to clozapine) from seizures, intestinal obstruction or agranulocytosis.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
