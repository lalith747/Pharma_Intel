      <data key="d3">12506270</data>
      <data key="d6">15</data>
      <data key="d7">It is suggested that drug interactions may be responsible for neutropenia in clozapine treated patients and that clozapine should not necessarily be discontinued in the presence of neutropenia.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
