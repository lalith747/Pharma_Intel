    <node id="evidence:17190527:10:00103">
      <data key="d1">evidence</data>
      <data key="d2">supported evidence</data>
      <data key="d3">17190527</data>
      <data key="d6">10</data>
      <data key="d7">Where clozapine is clearly the cause of agranulocytosis, rechallenge should not be considered or undertaken unless there are very exceptional circumstances (severe and prolonged relapse following clozapine discontinuation).</data>
      <data key="d8">supported</data>
      <data key="d9">[{"type": "causal_wording", "text": "cause", "start": 31, "end": 36}]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
      <data key="d12">3.949862763670301</data>
    </node>
    <node id="evidence:17190527:13:00104">
      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">17190527</data>
      <data key="d6">13</data>
      <data key="d7">Uncertainty over the likely cause of blood dyscrasia in people taking clozapine, coupled with uncertainty over the mechanism by which clozapine causes both neutropenia and agranulocytosis, makes any attempt to restart clozapine a high-risk venture requiring the utmost caution.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[{"kind": "speculation", "text": "likely", "start": 21, "end": 27}]</data>
