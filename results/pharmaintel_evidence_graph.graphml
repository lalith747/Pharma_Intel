      <data key="d3">28437295</data>
      <data key="d6">2</data>
      <data key="d7">Granulocyte colony-stimulating factor (G-CSF) and granulocyte-macrophage colony-stimulating factor (GM-CSF) have been used to reduce the frequency and duration of clozapine-associated neutropenia.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
