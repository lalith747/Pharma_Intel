      <data key="d3">40302427</data>
      <data key="d6">4</data>
      <data key="d7">The purpose of this study was to evaluate the discontinuation rate of clozapine due to severe neutropenia during the COVID-19 pandemic.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
