      <data key="d3">30864459</data>
      <data key="d6">6</data>
      <data key="d7">RESULTS: We located 20 studies that reported rates of neutropenia associated with clozapine and other antipsychotic medications.</data>
      <data key="d8">supported</data>
      <data key="d9">[{"type": "associated", "text": "associated with", "start": 66, "end": 81}]</data>
      <data key="d10">[]</data>
