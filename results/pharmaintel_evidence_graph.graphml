      <data key="d2">PMID 36620672</data>
      <data key="d3">36620672</data>
      <data key="d4">Neutropenia after the coadministration of clozapine and nirmatrelvir-ritonavir in a patient with SARS-CoV-2 infection: A case report with a literature review.</data>
      <data key="d5">2022</data>
    </node>
    <node id="evidence:36620672:5:00363">
      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">36620672</data>
      <data key="d6">5</data>
      <data key="d7">CASE PRESENTATION: We report a clozapine-treated patient with SARS-CoV-2 infection who developed neutropenia after coadministration with Paxlovid.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
