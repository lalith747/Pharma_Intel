    <node id="evidence:28817489:2:00575">
      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">28817489</data>
      <data key="d6">2</data>
      <data key="d7">Granulocyte colony-stimulating factor (G-CSF) has been used to support clozapine rechallenge after neutropenia with the aim of maintaining the neutrophil count.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
