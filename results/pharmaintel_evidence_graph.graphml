      <data key="d1">publication</data>
      <data key="d2">PMID 34483771</data>
      <data key="d3">34483771</data>
      <data key="d4">Never Say Never: Successful Clozapine Rechallenge After Multiple Episodes of Neutropenia.</data>
      <data key="d5">2021 Jan</data>
    </node>
    <node id="evidence:34483771:4:00426">
      <data key="d1">evidence</data>
