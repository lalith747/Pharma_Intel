    <node id="evidence:18330777:1:00082">
      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">18330777</data>
      <data key="d6">1</data>
      <data key="d7">OBJECTIVES: The aim of the present paper was to examine the concept of benign ethnic neutropenia and to consider the implications of ethnicity in the current clozapine regulatory system.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
