      <data key="d3">40302427</data>
      <data key="d6">2</data>
      <data key="d7">Routine monitoring of an absolute neutrophil count (ANC) is required to detect severe neutropenia, which is a black box warning for clozapine.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
