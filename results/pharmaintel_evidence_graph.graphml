    <node id="evidence:16234875:1:00012">
      <data key="d1">evidence</data>
      <data key="d2">supported evidence</data>
      <data key="d3">16234875</data>
      <data key="d6">1</data>
      <data key="d7">Psychotropic medications have been known to cause blood dyscrasias, including neutropenia, and since the advent of clozapine, this side effect is now increasingly being recognized.</data>
      <data key="d8">supported</data>
      <data key="d9">[{"type": "adverse_effect_wording", "text": "side effect", "start": 131, "end": 142}]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
      <data key="d12">4.379310388184409</data>
    </node>
