      <data key="d3">17170061</data>
      <data key="d6">8</data>
      <data key="d7">It is likely that African Americans had clozapine discontinued unnecessarily due to benign ethnic neutropenia.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[{"kind": "speculation", "text": "likely", "start": 6, "end": 12}]</data>
