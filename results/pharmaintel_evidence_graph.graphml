    <node id="evidence:27121434:3:00847">
      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">27121434</data>
      <data key="d6">3</data>
      <data key="d7">However, there is limited literature on late onset agranulocytosis with clozapine and this has very rarely been linked to human leukocyte-antigen haplotypes vulnerability.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
