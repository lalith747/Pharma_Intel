    <node id="publication:17190527">
      <data key="d1">publication</data>
      <data key="d2">PMID 17190527</data>
      <data key="d3">17190527</data>
      <data key="d4">Restarting clozapine after neutropenia: evaluating the possibilities and practicalities.</data>
      <data key="d5">2007</data>
    </node>
    <node id="evidence:17190527:2:00096">
      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">17190527</data>
      <data key="d6">2</data>
      <data key="d7">When neutropenia or agranulocytosis occur in people taking clozapine, cessation of treatment is mandated and relapse often results.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
