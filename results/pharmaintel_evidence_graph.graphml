      <data key="d2">PMID 37971414</data>
      <data key="d3">37971414</data>
      <data key="d4">The clozapine conundrum: Navigating neutropenia and the pursuit of effective care in treatment-resistant schizophrenia.</data>
      <data key="d5">2024 Sep</data>
    </node>
    <node id="evidence:37971414:1:00107">
      <data key="d1">evidence</data>
      <data key="d2">supported evidence</data>
      <data key="d3">37971414</data>
      <data key="d6">1</data>
      <data key="d7">&lt;b&gt;Background:&lt;/b&gt; This case explores the challenges encountered in managing treatment-resistant paranoid schizophrenia, focusing on the limitations of using clozapine due to the risk of neutropenia.</data>
      <data key="d8">supported</data>
      <data key="d9">[{"type": "risk_language", "text": "risk of", "start": 179, "end": 186}]</data>
      <data key="d10">[]</data>
