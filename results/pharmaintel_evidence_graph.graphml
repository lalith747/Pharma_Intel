      <data key="d2">supported evidence</data>
      <data key="d3">29944418</data>
      <data key="d6">1</data>
      <data key="d7">Clozapine-induced neutropenia occurs in 3-5% of individuals treated with clozapine.</data>
      <data key="d8">supported</data>
      <data key="d9">[{"type": "causal_wording", "text": "induced", "start": 10, "end": 17}]</data>
