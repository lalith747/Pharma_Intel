      <data key="d3">30084338</data>
      <data key="d6">1</data>
      <data key="d7">BACKGROUND: The clozapine-derivative quetiapine has been shown in some cases to cause leukopenia and neutropenia.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
      <data key="d12">4.379310388184409</data>
    </node>
    <node id="evidence:30084338:3:00273">
      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">30084338</data>
      <data key="d6">3</data>
      <data key="d7">After failed trials of three antipsychotic medications and despite a history of quetiapineinduced leukopenia, clozapine treatment was introduced due to the severity of the patient's symptoms, the limited effective treatment options, and a lack of guidelines on this issue.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
      <data key="d12">2.278000509158452</data>
    </node>
    <node id="evidence:30084338:4:00274">
      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">30084338</data>
      <data key="d6">4</data>
      <data key="d7">RESULT: Over a ten-week period of clozapine treatment at 700 mg per day, the patient developed agranulocytosis.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
      <data key="d12">3.949862763670301</data>
    </node>
    <node id="evidence:30084338:7:00275">
      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">30084338</data>
      <data key="d6">7</data>
      <data key="d7">CONCLUSION: The safety of clozapine in a patient who has previously experienced leukopenia and neutropenia with quetiapine requires further investigation.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
      <data key="d12">2.278000509158452</data>
    </node>
