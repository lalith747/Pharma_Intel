      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">31094900</data>
      <data key="d6">10</data>
      <data key="d7">Clozapine-associated neutropenia risk in Latino users is similar than in the rest of the world.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
