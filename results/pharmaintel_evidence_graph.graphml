      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">30864459</data>
      <data key="d6">4</data>
      <data key="d7">An electronic search of Medline (1948-2018), PsycINFO (1967-2018) and Embase (1947-2018) using search terms (clozapine OR clopine OR clozaril OR zaponex) AND (neutropenia OR agranulocytosis) was undertaken.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
      <data key="d12">4.379310388184409</data>
    </node>
    <node id="evidence:30864459:4:00359">
      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">30864459</data>
      <data key="d6">4</data>
      <data key="d7">An electronic search of Medline (1948-2018), PsycINFO (1967-2018) and Embase (1947-2018) using search terms (clozapine OR clopine OR clozaril OR zaponex) AND (neutropenia OR agranulocytosis) was undertaken.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
