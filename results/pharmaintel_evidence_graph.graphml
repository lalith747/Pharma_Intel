    </node>
    <node id="evidence:31094900:9:00490">
      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">31094900</data>
      <data key="d6">9</data>
      <data key="d7">22.8% of clozapine users (1227/5380) discontinued treatment for any cause and 4.2% (225/5380) due to neutropenia in any severity level.</data>
      <data key="d8">co_mention</data>
