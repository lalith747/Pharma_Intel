      <data key="d3">42903121</data>
      <data key="d6">14</data>
      <data key="d7">DISCUSSION: This case highlights the diagnostic challenge of neutropenia in psychiatric patients on clozapine, who are also undergoing treatment for comorbid medical conditions.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
