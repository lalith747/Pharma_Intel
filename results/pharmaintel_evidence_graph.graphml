    <node id="evidence:23510445:12:00379">
      <data key="d1">evidence</data>
      <data key="d2">co_mention evidence</data>
      <data key="d3">23510445</data>
      <data key="d6">12</data>
      <data key="d7">CONCLUSIONS: Our study shows that the rates of neutropenia in clozapine-treated children and adolescents are considerably higher than in the adult population.</data>
      <data key="d8">co_mention</data>
      <data key="d9">[]</data>
      <data key="d10">[]</data>
      <data key="d11">case_study_lexicon_pair_scoped_rule_baseline</data>
      <data key="d12">4.379310388184409</data>
    </node>
