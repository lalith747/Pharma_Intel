      <data key="d2">co_mention evidence</data>
      <data key="d3">12506270</data>
      <data key="d6">12</data>
      <data key="d7">In our patient neutropenia occurred 5 and 7 years after starting clozapine.</data>
      <data key="d8">co_mention</data>
